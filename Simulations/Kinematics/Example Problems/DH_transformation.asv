function A = DH_transformation(a,alpha,d,theta)
%%% C3376353
%%% Joshua Thomas

    n = length(a);
    
    A = [cos(theta) -cos(alpha)*sin(theta) sin(alpha)*sin(theta) a*cos(theta);
         sin(theta) -cos(alpha)*cos(theta) -sin(alpha)*cos(theta) a*sin(theta);
         0 sin(alpha) cos(alpha) d;
         0 0 0]

end