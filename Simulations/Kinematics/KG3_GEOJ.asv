function J = KG3_GEOJ(T_all)

% Extracting the end effector position vector
T08 = T_all{end};
pe = T08(1:3,end);

% % Initialising the base frame z vector and homogeneous position vector
% z0 = [0;0;1];
% % p0_hom = [0;0;0;1];
% % p0 = [0;0;0];
N = width(T_all);
for i=1:N

    R = T_all{i}(1:3,1:3);
    zi_min_1 = R(:,3);

    pi_min_1 = T_all{i}(1:3,4);
    
    Jp = cross(zi_min_1, pe - pi_min_1);
    Jo = zi_min_1;
    J = [J Jp];

end

end
